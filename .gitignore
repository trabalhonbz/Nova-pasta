# Ruflo local secrets and runtime data
.env
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/

# Dependências instaladas via npm
node_modules/

# Cache do PowerShell capturado por engano pelo OneDrive
Microsoft/

# Segredos do wrangler dev
.dev.vars

# Segredo de produção gerado pelo script de publicação
.pepper-producao.txt

# Estado local do wrangler: banco D1 de desenvolvimento e caches de build.
# Fica de fora do git por duas razões, e a segunda é a séria:
#   - é estado de máquina, recriável com `npm run db:local`;
#   - o banco guarda a tabela `usuarios`, com hash e salt das senhas.
.wrangler/

# Pasta publica montada por scripts/montar-site.mjs a cada deploy.
# E copia derivada do index.html e de src/; versiona-la criaria duas verdades
# para o mesmo arquivo e um diff enorme a cada build.
site/

# Copias de backup: o dump do D1 contem os hashes de senha de todo mundo, e a
# pasta de fotos pesa. Versionar isso publicaria credencial e incharia o repo.
backups/
